.form-card { padding: 30rpx; }
.step-index { color: #a8754d; font-size: 23rpx; font-weight: 720; letter-spacing: 2rpx; }
.field { margin-bottom: 24rpx; }
.field-grid { display: flex; gap: 16rpx; }
.half-field { flex: 1; min-width: 0; }
.picker { overflow: hidden; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.location-line { display: flex; gap: 12rpx; }
.location-input { flex: 1; min-width: 0; }
.location-button { width: 150rpx; min-height: 88rpx; margin: 0; padding: 0; font-size: 24rpx; }
.accurate-location { color: #176557; }
.content-count { margin-top: 10rpx; color: #929793; font-size: 21rpx; text-align: right; }
.photo-picker { padding: 52rpx 20rpx; border: 2rpx dashed #c9cec9; border-radius: 22rpx; background: #f8f7f3; text-align: center; }
.photo-plus { width: 74rpx; height: 74rpx; margin: 0 auto 14rpx; border-radius: 22rpx; background: #e8f0ec; color: #176557; font-size: 44rpx; line-height: 70rpx; }
.photo-title { font-weight: 650; }
.photo-note { margin-top: 8rpx; font-size: 22rpx; }
.photo-preview-wrap { overflow: hidden; border-radius: 22rpx; background: #f7f6f2; }
.photo-preview { display: block; width: 100%; height: 340rpx; }
.photo-meta { display: flex; justify-content: space-between; padding: 18rpx 20rpx; color: #737b77; font-size: 22rpx; }
.remove-photo { color: #a44535; font-weight: 650; }
.submit-button { margin-top: 36rpx; }
