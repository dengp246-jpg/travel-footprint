.map-page { padding-left: 22rpx; padding-right: 22rpx; }
.scope-switch { display: flex; gap: 8rpx; margin-bottom: 20rpx; padding: 8rpx; border-radius: 20rpx; background: #e8e7e1; }
.scope-item { flex: 1; padding: 18rpx 10rpx; border-radius: 15rpx; color: #6f7772; text-align: center; font-weight: 620; }
.scope-item.active { background: #ffffff; color: #176557; box-shadow: 0 6rpx 18rpx rgba(35, 48, 43, .08); }
.map-frame { position: relative; overflow: hidden; border: 2rpx solid rgba(23, 101, 87, .18); border-radius: 30rpx; box-shadow: 0 24rpx 58rpx rgba(26, 49, 42, .14); }
.native-map { display: block; width: 100%; height: 760rpx; }
.map-badge, .map-count { position: absolute; top: 20rpx; z-index: 2; padding: 10rpx 15rpx; border-radius: 12rpx; background: rgba(20, 42, 36, .84); color: #ffffff; font-size: 19rpx; letter-spacing: 2rpx; }
.map-badge { left: 20rpx; }
.map-count { right: 20rpx; letter-spacing: 0; }
.province-scroll { width: 100%; margin: 22rpx 0; white-space: nowrap; }
.province-row { display: inline-flex; gap: 12rpx; padding: 2rpx 4rpx 8rpx; }
.province-chip { padding: 14rpx 20rpx; border: 2rpx solid #dfdfd8; border-radius: 16rpx; background: #fbfaf7; color: #59635e; font-size: 23rpx; }
.province-chip text { margin-left: 6rpx; color: #9a714d; }
.province-chip.selected { border-color: #176557; background: #176557; color: #fff; }
.province-chip.selected text { color: #d8eee8; }
.point-card { padding-top: 26rpx; }
.point-item { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 0; border-top: 2rpx solid #efeee9; }
.route-index { width: 52rpx; height: 52rpx; border-radius: 17rpx; background: #e8f0ec; color: #176557; font-size: 23rpx; font-weight: 720; line-height: 52rpx; text-align: center; }
.point-copy { flex: 1; min-width: 0; }
.point-title { overflow: hidden; font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.point-note { overflow: hidden; margin-top: 7rpx; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.point-arrow { color: #a3aaa6; font-size: 38rpx; }
.compact-empty { padding: 40rpx 20rpx; }
