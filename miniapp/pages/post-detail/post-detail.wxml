<view class="detail-page">
  <view wx:if="{{loading && !post}}" class="loading-state">正在打开这段旅途…</view>
  <block wx:if="{{post}}">
    <image wx:if="{{post.photoUrl}}" class="detail-photo" mode="aspectFill" src="{{post.photoUrl}}"></image>
    <view wx:else class="detail-placeholder"><text>{{post.province}}</text></view>

    <view class="detail-content-wrap">
      <view class="detail-author">
        <view class="avatar">{{post.authorInitial}}</view>
        <view class="author-copy"><view class="author-name">{{post.author.nickname}}</view><view class="muted author-note">{{post.dateLabel}} · {{post.province}}</view></view>
        <view class="tag">{{post.category}}</view>
      </view>

      <view class="detail-title">{{post.title}}</view>
      <view class="detail-location">⌖ {{post.location}}</view>
      <view wx:if="{{post.tags}}" class="tag-list"><view class="tag tag-warm">{{post.tags}}</view></view>

      <view class="story-label">TRAVEL NOTE</view>
      <view class="detail-story">{{post.content}}</view>

      <view wx:if="{{post.videoUrl}}" class="detail-video-card">
        <view class="story-label video-label">TRAVEL VIDEO</view>
        <video class="detail-video" src="{{post.videoUrl}}" controls="{{true}}" show-center-play-btn="{{true}}" enable-play-gesture="{{true}}" object-fit="contain"></video>
      </view>

      <view wx:if="{{post.owned}}" class="video-manager">
        <view><view class="manager-title">管理旅行视频</view><view class="muted manager-note">支持 MP4、WebM，最大{{maxVideoLabel}}</view></view>
        <view class="manager-actions">
          <button class="button-secondary manager-button" loading="{{updatingVideo}}" disabled="{{updatingVideo}}" bindtap="replaceVideo">{{post.videoPath ? '替换视频' : '添加视频'}}</button>
          <button wx:if="{{post.videoPath}}" class="delete-video-button" disabled="{{updatingVideo}}" bindtap="removeVideo">删除</button>
        </view>
      </view>

      <view wx:if="{{post.owned}}" class="privacy-manager">
        <view class="manager-title">管理可见范围与地图隐私</view>
        <view class="privacy-field"><text>谁可以查看</text><picker mode="selector" range="{{visibilityOptions}}" range-key="label" value="{{visibilityIndex}}" bindchange="onPrivacyVisibilityChange"><view class="privacy-picker">{{visibilityOptions[visibilityIndex].label}}</view></picker></view>
        <view class="privacy-switch-row"><view><view class="privacy-switch-title">隐藏具体地图点位</view><text>对其他可见用户只展示省份范围</text></view><switch color="#176557" checked="{{post.approximateLocation}}" bindchange="onPrivacyApproximateChange" /></view>
        <view class="privacy-result"><text>隐私结果预览</text><view class="privacy-result-title">{{privacyTitle}}</view><view>{{privacyText}}</view></view>
        <button class="button-primary privacy-save" loading="{{updatingPrivacy}}" disabled="{{updatingPrivacy}}" bindtap="savePrivacy">保存隐私设置</button>
      </view>

      <view class="interaction-card">
        <view class="action {{post.liked ? 'active' : ''}}" bindtap="toggleLike"><view class="action-icon">♡</view><view><view class="action-value">{{post.likeCount}}</view><view class="action-label">点赞</view></view></view>
        <view class="action-divider"></view>
        <view class="action {{post.favorited ? 'active warm' : ''}}" bindtap="toggleFavorite"><view class="action-icon">☆</view><view><view class="action-value">{{post.favoriteCount}}</view><view class="action-label">收藏</view></view></view>
        <view class="action-divider"></view>
        <view class="action static"><view class="action-icon">◌</view><view><view class="action-value">{{post.commentCount}}</view><view class="action-label">评论</view></view></view>
      </view>

      <view class="rating-line"><text>旅行评分</text><text class="rating-value">{{post.ratingAverage || '暂无'}}</text></view>
    </view>
  </block>
</view>
