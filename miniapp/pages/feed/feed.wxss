.search-card,
.empty-card {
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 20rpx;
}

.post-card {
  margin-bottom: 24rpx;
}

.post-photo {
  width: 100%;
  height: 320rpx;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  background: #e5e7eb;
}

.post-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.post-excerpt {
  line-height: 1.7;
  margin: 18rpx 0;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.stat-line {
  font-size: 24rpx;
}
