.arrival-page { padding-left: 24rpx; padding-right: 24rpx; }
.arrival-hero { margin-top: 28rpx; padding: 46rpx 34rpx; border-radius: 34rpx; color: #fff; background: radial-gradient(circle at 80% 10%, rgba(245,177,77,.28), transparent 32%), linear-gradient(145deg,#0c3f39,#176557 65%,#2e7f70); box-shadow: 0 26rpx 58rpx rgba(23,101,87,.24); }
.arrival-symbol { display: grid; width: 90rpx; height: 90rpx; place-items: center; border: 2rpx solid rgba(255,255,255,.24); border-radius: 28rpx; background: rgba(255,255,255,.12); font-size: 46rpx; }
.arrival-hero .eyebrow { margin-top: 28rpx; color: #a9ddd2; }
.arrival-title { margin-top: 10rpx; font-size: 48rpx; font-weight: 760; }
.arrival-copy { margin-top: 16rpx; color: rgba(255,255,255,.72); line-height: 1.7; }
.arrival-toggle { margin-top: 30rpx; border-radius: 20rpx; color: #176557; background: #fff; font-weight: 700; }
.arrival-toggle.is-enabled { color: #8b4d26; background: #fff1e3; }
.status-card, .prompt-card, .privacy-card { margin-top: 22rpx; }
.status-heading { display: flex; align-items: center; gap: 14rpx; font-size: 29rpx; font-weight: 700; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #a8aeaa; }
.status-dot.is-live { background: #19a47e; box-shadow: 0 0 0 9rpx rgba(25,164,126,.12); }
.status-detail { margin-top: 15rpx; line-height: 1.65; }
.settings-link { margin: 20rpx 0 0; padding: 0; color: #176557; background: transparent; font-size: 23rpx; text-align: left; }
.settings-link::after { border: 0; }
.prompt-card { border: 2rpx solid #c9e5dd; background: linear-gradient(145deg,#fff,#eef9f6); }
.prompt-symbol { width: 64rpx; height: 64rpx; border-radius: 20rpx; color: #fff; background: #d88335; font-weight: 760; line-height: 64rpx; text-align: center; }
.prompt-card .eyebrow { margin-top: 22rpx; }
.prompt-title { margin-top: 8rpx; color: #145d53; font-size: 37rpx; font-weight: 740; }
.prompt-copy { margin-top: 13rpx; color: #5e736e; line-height: 1.65; }
.prompt-accuracy { margin: 14rpx 0 24rpx; color: #85928e; font-size: 21rpx; }
.prompt-card button + button { margin-top: 12rpx; }
.privacy-row { display: grid; grid-template-columns: 62rpx 1fr; gap: 14rpx; margin-top: 22rpx; color: #5f706c; line-height: 1.6; }
.privacy-row text { color: #b27648; font-size: 20rpx; font-weight: 720; letter-spacing: 2rpx; }
