# Copy to deploy/oracle/.env on the Oracle VM. Never commit the real file.
# Use a domain name for automatic HTTPS, for example travel.example.com.
# For an initial HTTP-only IP test, use http://203.0.113.10.
SITE_ADDRESS=travel.example.com

# Use a unique value of at least 12 characters, then change it after first login.
APP_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-password

# AMap browser configuration. These values are intentionally empty in Git.
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_PROXY_ENABLED=true

# Application limits and session lifetime.
APP_UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880
APP_UPLOAD_MAX_VIDEO_SIZE_BYTES=20971520
APP_MINI_SESSION_VALIDITY_DAYS=30
