.form-card { padding: 30rpx; }
.arrival-prefill-banner { display: flex; align-items: flex-start; gap: 18rpx; margin: 0 0 22rpx; padding: 24rpx; border: 2rpx solid #cde4df; border-radius: 22rpx; background: linear-gradient(135deg,#effaf7,#fff); }
.arrival-prefill-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; border-radius: 20rpx; background: #176557; color: #fff; font-size: 34rpx; }
.arrival-prefill-title { color: #153f3a; font-size: 26rpx; font-weight: 720; }
.arrival-prefill-copy { margin-top: 8rpx; color: #58716c; font-size: 21rpx; line-height: 1.55; }
.step-index { color: #a8754d; font-size: 23rpx; font-weight: 720; letter-spacing: 2rpx; }
.field { margin-bottom: 24rpx; }
.field-grid { display: flex; gap: 16rpx; }
.half-field { flex: 1; min-width: 0; }
.picker { overflow: hidden; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.location-line { display: flex; gap: 12rpx; }
.location-input { flex: 1; min-width: 0; }
.location-button { width: 150rpx; min-height: 88rpx; margin: 0; padding: 0; font-size: 24rpx; }
.accurate-location { color: #176557; }
.content-count { margin-top: 10rpx; color: #929793; font-size: 21rpx; text-align: right; }
.photo-picker { padding: 52rpx 20rpx; border: 2rpx dashed #c9cec9; border-radius: 22rpx; background: #f8f7f3; text-align: center; }
.photo-plus { width: 74rpx; height: 74rpx; margin: 0 auto 14rpx; border-radius: 22rpx; background: #e8f0ec; color: #176557; font-size: 44rpx; line-height: 70rpx; }
.photo-title { font-weight: 650; }
.photo-note { margin-top: 8rpx; font-size: 22rpx; }
.photo-preview-wrap { overflow: hidden; border-radius: 22rpx; background: #f7f6f2; }
.photo-preview { display: block; width: 100%; height: 340rpx; }
.photo-meta { display: flex; justify-content: space-between; padding: 18rpx 20rpx; color: #737b77; font-size: 22rpx; }
.remove-photo { color: #a44535; font-weight: 650; }
.video-picker { background: #f1f6f4; border-color: #b9d2ca; }
.video-plus { background: #dcece7; font-size: 30rpx; }
.video-preview-wrap { overflow: hidden; border-radius: 22rpx; background: #071b1d; }
.video-preview { display: block; width: 100%; height: 390rpx; background: #071b1d; }
.video-preview-wrap .photo-meta { background: #f7f6f2; }
.privacy-switch-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx; border: 2rpx solid #e1e7e4; border-radius: 20rpx; background: #f8faf9; }
.privacy-switch-title { color: #314a44; font-size: 25rpx; font-weight: 650; }
.privacy-switch-note { max-width: 500rpx; margin-top: 7rpx; font-size: 20rpx; }
.privacy-preview { margin-top: 18rpx; padding: 24rpx; border: 2rpx solid #cde4df; border-left: 8rpx solid #176557; border-radius: 20rpx; background: linear-gradient(135deg,#effaf7,#fff); }
.privacy-preview-kicker { color: #176557; font-size: 18rpx; font-weight: 720; letter-spacing: 2rpx; }
.privacy-preview-title { margin-top: 8rpx; color: #153f3a; font-size: 28rpx; font-weight: 720; }
.privacy-preview-copy { margin-top: 8rpx; color: #58716c; font-size: 21rpx; line-height: 1.6; }
.submit-button { margin-top: 36rpx; }
