<view class="page-shell map-page">
  <view class="page-hero">
    <view class="eyebrow">LIVE ATLAS</view>
    <view class="page-title">旅行地图</view>
    <view class="page-subtitle">公共地图看见旅行分布，个人地图按发布时间连接你的每一站。</view>
  </view>

  <view class="scope-switch">
    <view class="scope-item {{mine ? '' : 'active'}}" bindtap="switchScope" data-mine="false">全国足迹</view>
    <view class="scope-item {{mine ? 'active' : ''}}" bindtap="switchScope" data-mine="true">个人轨迹</view>
  </view>

  <view class="map-frame">
    <map
      class="native-map"
      latitude="{{centerLatitude}}"
      longitude="{{centerLongitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      include-points="{{includePoints}}"
      show-location
      enable-zoom
      enable-scroll
      bindmarkertap="onMarkerTap"
    ></map>
    <view class="map-badge">{{mine ? 'PERSONAL ROUTE' : 'PUBLIC ATLAS'}}</view>
    <view class="map-count">{{visiblePoints.length}} 个点位</view>
  </view>

  <scroll-view wx:if="{{provinces.length}}" class="province-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="province-row">
      <view class="province-chip {{selectedProvince === '' ? 'selected' : ''}}" bindtap="clearProvince">全部</view>
      <view class="province-chip {{selectedProvince === item.province ? 'selected' : ''}}" wx:for="{{provinces}}" wx:key="province" bindtap="selectProvince" data-province="{{item.province}}">
        {{item.province}} <text>{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="card point-card">
    <view class="section-head">
      <view class="section-title">{{selectedProvince || '全部地点'}}</view>
      <view class="section-note">{{mine ? '依发布时间排序' : '点选查看详情'}}</view>
    </view>
    <view wx:for="{{visiblePoints}}" wx:key="postId" class="point-item" bindtap="openDetail" data-id="{{item.postId}}">
      <view class="route-index">{{index + 1}}</view>
      <view class="point-copy">
        <view class="point-title">{{item.location}}</view>
        <view class="muted point-note">{{item.title}} · {{item.travelDate}}</view>
      </view>
      <view class="point-arrow">›</view>
    </view>
    <view wx:if="{{!loading && visiblePoints.length === 0}}" class="empty-state compact-empty">
      <view class="empty-symbol">图</view>
      <view class="empty-title">这里还没有足迹</view>
      <view class="empty-copy">发布旅行记录后，点位会自动出现在地图上。</view>
    </view>
  </view>
</view>
