.home-hero { padding-top: 16rpx; }
.overview-card { display: flex; align-items: center; gap: 24rpx; margin-bottom: 22rpx; }
.overview-main { min-width: 82rpx; }
.overview-value { color: #17211e; font-size: 42rpx; font-weight: 760; line-height: 1; }
.overview-label { margin-top: 8rpx; color: #7b827e; font-size: 21rpx; }
.overview-divider { width: 2rpx; height: 58rpx; background: #e7e6e0; }
.publish-button { flex: 1; margin: 0 0 0 auto; }
.search-card { margin-bottom: 36rpx; padding: 20rpx; }
.search-line { display: flex; gap: 12rpx; }
.search-input { flex: 1; min-width: 0; min-height: 76rpx; }
.search-button { width: 116rpx; min-height: 76rpx; margin: 0; border-radius: 18rpx; padding: 0; }
.province-select { padding: 18rpx 6rpx 2rpx; color: #5f6964; font-size: 23rpx; }
.feed-heading { display: flex; align-items: end; justify-content: space-between; margin: 0 4rpx 20rpx; }
.post-card { overflow: hidden; margin-bottom: 24rpx; padding: 0; }
.post-photo, .post-placeholder { width: 100%; height: 340rpx; }
.post-photo { background: #dfe4df; }
.post-placeholder { display: flex; align-items: center; justify-content: center; background: linear-gradient(140deg, #174d45, #438174); color: rgba(255,255,255,.84); font-size: 42rpx; letter-spacing: 8rpx; }
.post-content { padding: 26rpx; }
.post-author { display: flex; align-items: center; gap: 14rpx; }
.small-avatar { width: 62rpx; height: 62rpx; border-radius: 18rpx; font-size: 25rpx; }
.author-copy { flex: 1; min-width: 0; }
.author-name { font-size: 25rpx; font-weight: 650; }
.author-meta { margin-top: 3rpx; font-size: 21rpx; }
.post-title { margin-top: 22rpx; color: #1b2622; font-size: 36rpx; font-weight: 730; line-height: 1.35; }
.post-location { margin-top: 10rpx; color: #176557; font-size: 23rpx; }
.post-excerpt { margin: 18rpx 0 22rpx; color: #5e6863; line-height: 1.7; }
.post-footer { display: flex; gap: 24rpx; padding-top: 20rpx; border-top: 2rpx solid #efeee9; color: #7d847f; font-size: 23rpx; }
.active-stat { color: #b86c35; }
.open-hint { margin-left: auto; color: #176557; font-weight: 600; }
