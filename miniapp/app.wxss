page {
  background: #f4f2ed;
  color: #24302c;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.page-hero {
  padding: 24rpx 4rpx 32rpx;
}

.eyebrow {
  color: #176557;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 12rpx;
  color: #17211e;
  font-size: 52rpx;
  font-weight: 760;
  line-height: 1.18;
  letter-spacing: -2rpx;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #727a75;
  line-height: 1.7;
}

.card {
  box-sizing: border-box;
  background: rgba(255, 255, 253, 0.96);
  border: 2rpx solid rgba(36, 48, 44, 0.08);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 54rpx rgba(33, 48, 42, 0.07);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-title {
  color: #1d2925;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-note,
.muted {
  color: #7a817d;
}

.section-note {
  font-size: 23rpx;
}

.divider {
  height: 2rpx;
  background: #ecebe6;
  margin: 24rpx 0;
}

.button-primary,
.button-secondary,
.button-ghost,
.button-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}

button::after {
  border: 0;
}

.button-primary {
  background: #176557;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(23, 101, 87, 0.2);
}

.button-secondary {
  background: #e8f0ec;
  color: #176557;
}

.button-ghost {
  background: #f7f6f2;
  color: #44514c;
  border: 2rpx solid #e8e6df;
}

.button-danger {
  background: #fff1ee;
  color: #a44535;
}

.button-small {
  min-height: 68rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #e8f0ec;
  color: #176557;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-warm {
  background: #fff2e5;
  color: #a6622b;
}

.input,
.textarea,
.picker {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  background: #f8f7f3;
  border: 2rpx solid #e4e3dd;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  color: #202b27;
}

.input:focus,
.textarea:focus {
  border-color: #76a89e;
}

.textarea {
  min-height: 240rpx;
  line-height: 1.65;
}

.field-label {
  display: block;
  margin: 0 0 12rpx 4rpx;
  color: #4c5752;
  font-size: 24rpx;
  font-weight: 600;
}

.field-help {
  margin: 10rpx 4rpx 0;
  color: #8b918e;
  font-size: 22rpx;
  line-height: 1.5;
}

.empty-state {
  padding: 64rpx 32rpx;
  text-align: center;
}

.empty-symbol {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: #e8f0ec;
  color: #176557;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #26322e;
  font-size: 31rpx;
  font-weight: 680;
}

.empty-copy {
  color: #7a817d;
  line-height: 1.7;
}

.loading-state {
  padding: 40rpx;
  color: #7a817d;
  text-align: center;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 auto;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: #176557;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 720;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-item {
  padding: 22rpx 12rpx;
  border-radius: 20rpx;
  background: #f6f5f1;
  text-align: center;
}

.stat-value {
  color: #1c2824;
  font-size: 36rpx;
  font-weight: 760;
}

.stat-label {
  margin-top: 6rpx;
  color: #7b827e;
  font-size: 22rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
