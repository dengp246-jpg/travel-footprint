{$SITE_ADDRESS} {
    encode zstd gzip

    reverse_proxy app:8080 {
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format console
    }
}
